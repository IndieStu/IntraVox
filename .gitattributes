# Exclude internal documentation from release archives (GitHub releases)
# These files are still tracked in git and pushed to all remotes,
# but won't be included in downloaded release tarballs/zips
docs/internal/ export-ignore

# Also exclude development files from releases
.claude/ export-ignore
.github/ export-ignore

# Screenshots are only for GitHub README documentation, not needed in app
screenshots/ export-ignore

# These legacy sources are intentionally CRLF. Treat CR at end of line as part
# of the line ending so `git diff --check` can still inspect added lines.
appinfo/routes.php whitespace=cr-at-eol
src/components/*.vue whitespace=cr-at-eol
